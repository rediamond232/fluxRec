+
+/* Private Fluxrec API: set after avcodec_open2(), before frame submission. */
+void avcodec_set_fluxrec_nvenc_api_timing_callback(
+    AVCodecContext *avctx, FluxrecNvencApiTimingCallback *callback, void *opaque)
+{
+    NvencContext *ctx;
+
+    if (!avctx || !avctx->codec || !avctx->priv_data ||
+        (av_strcasecmp(avctx->codec->name, "h264_nvenc") &&
+         av_strcasecmp(avctx->codec->name, "hevc_nvenc")))
+        return;
+
+    ctx = avctx->priv_data;
+    ctx->fluxrec_api_timing_callback = callback;
+    ctx->fluxrec_api_timing_opaque = callback ? opaque : NULL;
+}
+
+static uint64_t fluxrec_api_elapsed_ns(int64_t start_us, int64_t end_us)
+{
+    uint64_t elapsed_us;
+
+    if (end_us <= start_us)
+        return 0;
+
+    elapsed_us = end_us - start_us;
+    if (elapsed_us > UINT64_MAX / 1000)
+        return UINT64_MAX;
+
+    return elapsed_us * 1000;
+}
+
+static uint64_t fluxrec_api_monotonic_ns(int64_t time_us)
+{
+    if (!av_gettime_relative_is_monotonic() || time_us <= 0 ||
+        (uint64_t)time_us > (uint64_t)INT64_MAX / 1000)
+        return 0;
+
+    return (uint64_t)time_us * 1000;
+}
 
