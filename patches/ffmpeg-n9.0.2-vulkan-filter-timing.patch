+    if (timing && timing->enabled && exec->query_data_valid) {
+        const uint64_t *timestamps = exec->query_data;
+        uint64_t ticks = timestamps[1] - timestamps[0];
+        if (timing->timestamp_valid_bits < 64)
+            ticks &= (UINT64_C(1) << timing->timestamp_valid_bits) - 1;
+        long double elapsed_ns = (long double)ticks * timing->timestamp_period_ns;
+        if (elapsed_ns >= 0.0L && elapsed_ns <= UINT64_MAX) {
+            uint64_t elapsed = (uint64_t)elapsed_ns;
+            timing->batch_samples++;
+            timing->batch_total_ns += elapsed;
+            timing->batch_min_ns = FFMIN(timing->batch_min_ns, elapsed);
+            timing->batch_max_ns = FFMAX(timing->batch_max_ns, elapsed);
+            if (timing->batch_samples == 360) {
+                av_log(avctx, AV_LOG_INFO,
+                       "FLUXREC_FF_VK_DEVICE_TIMING stage=%s samples=%" PRIu64
+                       " mean_ns=%" PRIu64 " min_ns=%" PRIu64 " max_ns=%" PRIu64 "\n",
+                       avctx->name, timing->batch_samples,
+                       timing->batch_total_ns / timing->batch_samples,
+                       timing->batch_min_ns, timing->batch_max_ns);
+                timing->batch_samples = 0;
+                timing->batch_total_ns = 0;
+                timing->batch_min_ns = UINT64_MAX;
