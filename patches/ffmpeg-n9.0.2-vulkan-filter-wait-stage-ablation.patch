+void ff_vk_filter_wait_timing_flush(AVFilterContext *avctx,
+                                    FFVkFilterTiming *timing)
+{
+    if (!timing || !timing->wait_timing_enabled || !timing->wait_batch_samples)
+        return;
+
+    av_log(avctx, AV_LOG_INFO,
+           "FLUXREC_FF_VK_WAIT_TIMING filter=%s samples=%" PRIu64
+           " mean_us=%" PRIu64 " min_us=%" PRIu64 " max_us=%" PRIu64 "\n",
+           avctx->name ? avctx->name : "(unnamed)",
+           timing->wait_batch_samples,
+           timing->wait_batch_total_us / timing->wait_batch_samples,
+           timing->wait_batch_min_us, timing->wait_batch_max_us);
+    timing->wait_batch_samples = 0;
+    timing->wait_batch_total_us = 0;
+    timing->wait_batch_min_us = 0;
+    timing->wait_batch_max_us = 0;
