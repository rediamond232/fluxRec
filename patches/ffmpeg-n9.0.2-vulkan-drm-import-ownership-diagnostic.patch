@@ -3215,7 +3216,37 @@
 #if CONFIG_LIBDRM
 static void vulkan_unmap_from_drm(AVHWFramesContext *hwfc, HWMapDescriptor *hwmap)
 {
-    vulkan_frame_free(hwfc, hwmap->priv);
+    AVVkFrame *frame = hwmap->priv;
+    VulkanFramesPriv *fp = hwfc->hwctx;
+    VulkanDevicePriv *p = hwfc->device_ctx->hwctx;
+    const int nb_images = ff_vk_count_images(frame);
+    int all_external = 1;
+
+    /* Concurrent Vulkan image sharing does not remove the external API
+     * ownership handoff. FFmpeg's ordinary concurrent-image barriers can
+     * leave queue_family as IGNORED, so restore the family of this release
+     * submission. This diagnostic path assumes the DRM source is only used
+     * on the device's compute queue family. */
+    for (int i = 0; i < nb_images; i++) {
+        if (frame->queue_family[i] != VK_QUEUE_FAMILY_EXTERNAL)
+            all_external = 0;
+    }
+
+    if (!all_external) {
+        for (int i = 0; i < nb_images; i++) {
+            if (frame->queue_family[i] == VK_QUEUE_FAMILY_IGNORED)
+                frame->queue_family[i] = p->compute_qf->idx;
+        }
+
+        int err = switch_layout(hwfc, &fp->compute_exec, frame,
+                                PREP_MODE_EXTERNAL_EXPORT);
+        if (err < 0)
+            av_log(hwfc, AV_LOG_WARNING,
+                   "Failed to release imported DRM frame to external owner: %s\n",
+                   av_err2str(err));
+    }
+
+    vulkan_frame_free(hwfc, frame);
 }
 
