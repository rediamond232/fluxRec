+VkResult ff_vk_exec_wait_fence(FFVulkanContext *s, FFVkExecContext *e,
+                               uint64_t timeout_ns)
+{
+    VkResult ret;
+
+    if (!e->pending_submission)
+        return VK_SUCCESS;
+    if (!s || !s->hwctx || s->hwctx->act_dev == VK_NULL_HANDLE ||
+        !s->vkfn.WaitForFences)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    ret = s->vkfn.WaitForFences(s->hwctx->act_dev, 1, &e->fence,
+                                VK_TRUE, timeout_ns);
+    if (ret == VK_SUCCESS)
+        e->pending_submission = 0;
+
+    return ret;
+}
+
+VkResult ff_vk_exec_poll_fence(FFVulkanContext *s, FFVkExecContext *e)
+{
+    VkResult ret;
+
+    if (!e->pending_submission)
+        return VK_SUCCESS;
+    if (!s || !s->hwctx || s->hwctx->act_dev == VK_NULL_HANDLE ||
+        !s->vkfn.GetFenceStatus)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    ret = s->vkfn.GetFenceStatus(s->hwctx->act_dev, e->fence);
+    if (ret == VK_SUCCESS)
+        e->pending_submission = 0;
+
+    return ret;
+}
+
+VkResult ff_vk_exec_wait_fence_bounded(FFVulkanContext *s,
+                                               FFVkExecContext *e,
+                                               uint64_t timeout_ns)
+{
+    int64_t start_time_us = av_gettime_relative();
+
+    while (e->pending_submission) {
+        VkResult ret = ff_vk_exec_poll_fence(s, e);
+        int64_t elapsed_us;
+        uint64_t remaining_ns;
+        uint64_t remaining_us;
+        unsigned int sleep_us;
+
+        if (ret == VK_SUCCESS)
+            return VK_SUCCESS;
+        if (ret != VK_NOT_READY)
+            return ret;
+
+        elapsed_us = av_gettime_relative() - start_time_us;
+        if (elapsed_us < 0)
+            elapsed_us = 0;
+        if ((uint64_t)elapsed_us > timeout_ns / 1000 ||
+            ((uint64_t)elapsed_us == timeout_ns / 1000 &&
+             timeout_ns % 1000 == 0))
+            return VK_TIMEOUT;
+
+        remaining_ns = timeout_ns - (uint64_t)elapsed_us * 1000;
+        if (!remaining_ns)
+            return VK_TIMEOUT;
+        remaining_us = remaining_ns / 1000 + !!(remaining_ns % 1000);
+        sleep_us = remaining_us > 1000 ? 1000 : (unsigned int)remaining_us;
+        av_usleep(sleep_us ? sleep_us : 1);
+    }
+
+    return VK_SUCCESS;
+}
