+/**
+ * Poll pending submissions in this Vulkan frames context's compute execution
+ * pool against one total timeout budget, then release their retained
+ * dependencies. A timeout or poll error leaves unfinished submissions and
+ * their dependencies intact. The deadline uses a monotonic clock, but sleep
+ * scheduling and status-call latency can cause it to overshoot.
+ *
+ * The caller must ensure that no operation is concurrently using frames_ref.
+ * The pool remains initialized and may be used again after a successful call.
+ * Repeated calls are safe.
+ *
+ * @param frames_ref Vulkan AVHWFramesContext reference.
+ * @param timeout_ns Total poll budget in nanoseconds.
+ * @return 0 on success, AVERROR(ETIMEDOUT) on timeout, or another negative
+ *         AVERROR code on failure.
+ */
+int av_vk_frame_ctx_exec_pool_drain(AVBufferRef *frames_ref,
+                                    uint64_t timeout_ns);
