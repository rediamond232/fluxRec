+int av_vk_frame_ctx_exec_pool_drain(AVBufferRef *frames_ref,
+                                    uint64_t timeout_ns)
+{
+    AVHWFramesContext *hwfc;
+    VulkanDevicePriv *p;
+    VulkanFramesPriv *fp;
+    FFVkExecPool *pool;
+    int64_t start_time_us;
+
+    if (!frames_ref || !frames_ref->data)
+        return AVERROR(EINVAL);
+
+    hwfc = (AVHWFramesContext *)frames_ref->data;
+    if (hwfc->format != AV_PIX_FMT_VULKAN || !hwfc->device_ctx ||
+        hwfc->device_ctx->type != AV_HWDEVICE_TYPE_VULKAN ||
+        !hwfc->device_ctx->hwctx || !hwfc->hwctx)
+        return AVERROR(EINVAL);
+
+    p = hwfc->device_ctx->hwctx;
+    fp = hwfc->hwctx;
+    pool = &fp->compute_exec;
+    /* Make failure at final uninit fail-stop instead of freeing live resources. */
+    pool->fail_closed_drain = 1;
+
+    if (pool->pool_size < 0 || (pool->pool_size && !pool->contexts) ||
+        p->p.act_dev == VK_NULL_HANDLE || !p->vkctx.vkfn.GetFenceStatus)
+        return AVERROR(EINVAL);
+
+    start_time_us = av_gettime_relative();
+    for (int i = 0; i < pool->pool_size; i++) {
+        FFVkExecContext *exec = &pool->contexts[i];
+        VkResult ret;
+
+        if (exec->pending_submission && !exec->fence)
+            return AVERROR(EINVAL);
+
+        if (exec->pending_submission) {
+            int64_t elapsed_us = av_gettime_relative() - start_time_us;
+            uint64_t remaining_timeout_ns;
+
+            if (elapsed_us < 0)
+                elapsed_us = 0;
+            if ((uint64_t)elapsed_us > timeout_ns / 1000 ||
+                ((uint64_t)elapsed_us == timeout_ns / 1000 &&
+                 timeout_ns % 1000 == 0)) {
+                av_log(hwfc, AV_LOG_ERROR,
+                       "Timed out draining Vulkan frame execution pool\n");
+                return AVERROR(ETIMEDOUT);
+            }
+            remaining_timeout_ns = timeout_ns - (uint64_t)elapsed_us * 1000;
+
+            ret = ff_vk_exec_wait_fence_bounded(&p->vkctx, exec,
+                                                 remaining_timeout_ns);
+            if (ret == VK_TIMEOUT) {
+                av_log(hwfc, AV_LOG_ERROR,
+                       "Timed out draining Vulkan frame execution pool\n");
+                return AVERROR(ETIMEDOUT);
+            }
+            if (ret != VK_SUCCESS) {
+                av_log(hwfc, AV_LOG_ERROR,
+                       "Failed to drain Vulkan frame execution pool: %d\n", ret);
+                return AVERROR_EXTERNAL;
+            }
+        }
+
+        /* No dependencies are released until the submission completed. */
+        ff_vk_exec_discard_deps(&p->vkctx, exec);
+    }
+
+    return 0;
+}
