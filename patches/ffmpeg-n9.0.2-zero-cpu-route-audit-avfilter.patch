+static av_cold int scale_vulkan_init(AVFilterContext *ctx)
+{
+    ScaleVulkanContext *s = ctx->priv;
+    char *audit_env = getenv_utf8("FLUXREC_FF_ZERO_CPU_AUDIT");
+
+    s->fluxrec_zero_cpu_audit = audit_env && !strcmp(audit_env, "1");
+    freeenv_utf8(audit_env);
+    atomic_init(&s->fluxrec_zero_cpu_audit_pass_logged, 0);
+    atomic_init(&s->fluxrec_zero_cpu_audit_vulkan_frames, 0);
+    atomic_init(&s->fluxrec_zero_cpu_audit_rejected_frames, 0);
+
+    return ff_vk_filter_init(ctx);
+}
